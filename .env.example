# Keep this file free of real credentials.

# Public deployment label shown only in honest environment/status copy.
NEXT_PUBLIC_STRIDEBRAIN_ENV=development

# Server-side data classification boundary. v0.1 supports synthetic demo mode only.
STRIDEBRAIN_DATA_MODE=DEMO_SYNTHETIC

# Optional canonical origin for metadata/absolute URLs.
STRIDEBRAIN_APP_ORIGIN=http://localhost:3000

# Server-only signing key for opaque L1 demo sessions and domain-separated,
# one-hour quote-preparation signatures. Rotating it also invalidates unsaved suggestions.
# Generate at least 32 cryptographically random bytes for each environment.
# Never expose this through a NEXT_PUBLIC variable or commit a real value.
STRIDEBRAIN_DEMO_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional controlled SB-034 handoff. Only effective on VERCEL_ENV=preview,
# explicit synthetic mode, preview public environment, and a pinned HTTPS origin.
# Store only SHA-256 of a fresh random 32-byte base64url invitation; never the code.
STRIDEBRAIN_PREVIEW_HANDOFF_ENABLED=false
STRIDEBRAIN_PREVIEW_INVITE_SHA256=
STRIDEBRAIN_PREVIEW_INVITE_EXPIRES_AT=

# PostgreSQL database for the isolated local/CI/demo environment.
DATABASE_URL=postgresql://stridebrain:stridebrain@localhost:5432/stridebrain?schema=public

# Optional read-only assistant. Defaults off; keyword chat always remains available.
# Google Gemini PAID service only. The Product Director verifies billing/terms,
# sets these server-only variables, and configures hosted secrets personally.
STRIDEBRAIN_AI_ENABLED=false
STRIDEBRAIN_AI_PAID_TIER_CONFIRMED=false
STRIDEBRAIN_GEMINI_API_KEY=
STRIDEBRAIN_AI_PROVIDER=gemini
STRIDEBRAIN_AI_MODEL=gemini-3.5-flash-lite
# Standard text rates in USD / million tokens, checked 2026-11-22.
# Update both when changing model. Estimated cost includes thinking tokens.
STRIDEBRAIN_AI_INPUT_USD_PER_MILLION=0.30
STRIDEBRAIN_AI_OUTPUT_USD_PER_MILLION=2.50
STRIDEBRAIN_AI_TIMEOUT_MS=20000
STRIDEBRAIN_AI_MAX_TOOL_CALLS=6
STRIDEBRAIN_AI_MAX_OUTPUT_TOKENS=2048
# Atomic reservations, UTC day; provider failures also consume the cap.
STRIDEBRAIN_AI_DAILY_CALLS=500

# Paid evaluation runner only, on a disposable local/CI database.
# Comma-separated exact case ids select a focused diagnostic (not acceptance), skipping drafts.
# Empty runs the full three-round acceptance suite. Each dispatch needs the Director's budget.
STRIDEBRAIN_AI_EVAL_CASES=
STRIDEBRAIN_AI_EVAL_MAX_USD=0.50
