# Keep this file free of real credentials.

# Public deployment label shown only in honest environment/status copy.
NEXT_PUBLIC_STRIDEBRAIN_ENV=development

# Server-side data classification boundary. v0.1 supports synthetic demo mode only.
STRIDEBRAIN_DATA_MODE=DEMO_SYNTHETIC

# Optional canonical origin for metadata/absolute URLs.
STRIDEBRAIN_APP_ORIGIN=http://localhost:3000

# Server-only signing key for opaque L1 demo sessions.
# Generate at least 32 cryptographically random bytes for each environment.
# Never expose this through a NEXT_PUBLIC variable or commit a real value.
STRIDEBRAIN_DEMO_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional controlled SB-034 handoff. Only effective on VERCEL_ENV=preview,
# explicit synthetic mode, preview public environment, and a pinned HTTPS origin.
# Store only SHA-256 of a fresh random 32-byte base64url invitation; never the code.
STRIDEBRAIN_PREVIEW_HANDOFF_ENABLED=false
STRIDEBRAIN_PREVIEW_INVITE_SHA256=
STRIDEBRAIN_PREVIEW_INVITE_EXPIRES_AT=

# PostgreSQL database for the isolated local/CI/demo environment.
DATABASE_URL=postgresql://stridebrain:stridebrain@localhost:5432/stridebrain?schema=public
